{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "opener:default",
    "oauth:allow-start",
    "oauth:allow-cancel",
    "dialog:default",
    "global-shortcut:default",
    "sql:default",
    "sql:allow-execute",
    "updater:default"
  ]
}
