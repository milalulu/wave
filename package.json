{
  "name": "wave",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.6.0",
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent:eval": "node scripts/agent-eval.mjs",
    "agent:eval:test": "node --test scripts/agent-eval.test.mjs",
    "agent:benchmark": "node scripts/agent-benchmark.mjs",
    "agent:benchmark:test": "node --test scripts/agent-benchmark.test.mjs",
    "agent:scenarios": "vitest run --config evals/wave-agent/scenarios.config.ts",
    "agent:check-bundles": "node scripts/check-agent-bundles.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fabianlars/tauri-plugin-oauth": "^2.1.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
