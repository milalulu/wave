# Wave environment variables
# Copy to .env and fill in your keys

# yt-dlp binary path (optional, if not in PATH)
WAVE_YTDLP_PATH=

# SoundCloud API v2 client_id (get from browser devtools on soundcloud.com -> Network -> client_id)
WAVE_SOUNDCLOUD_CLIENT_ID=

# Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
WAVE_SPOTIFY_CLIENT_ID=
WAVE_SPOTIFY_CLIENT_SECRET=

# VK user token with 'audio' scope (get from VK OAuth)
WAVE_VK_TOKEN=

# Last.fm API key (https://www.last.fm/api/account/create)
WAVE_LASTFM_API_KEY=

# HTTP API token for Jarvis/external access (optional: if empty, auto-generated on first run)
# Save the printed token from console or read from ~/.config/com.wave.desktop/api-token
WAVE_API_TOKEN=